# ── Salesforce Connected App (OAuth 2.0) ──────────────────────────────────────
# https://help.salesforce.com/s/articleView?id=sf.connected_app_create.htm

SF_CLIENT_ID=3MVG9...your_consumer_key...
SF_CLIENT_SECRET=your_consumer_secret

# JWT Bearer Flow (推奨: サーバー間認証・ユーザー操作不要)
SF_JWT_PRIVATE_KEY_PATH=./certs/server.key  # openssl で生成した秘密鍵
SF_JWT_USERNAME=admin@yourorg.salesforce.com
SF_LOGIN_URL=https://login.salesforce.com   # Sandbox: https://test.salesforce.com

# Username/Password Flow (開発・テスト用のみ)
SF_USERNAME=your_username@yourorg.com
SF_PASSWORD=your_password
SF_SECURITY_TOKEN=your_security_token       # SF設定 > 個人設定 > セキュリティトークンのリセット

# Salesforce API バージョン
SF_API_VERSION=v59.0

# ── Claude API (NLP Intent Parser) ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...your_api_key...

# ── アプリ設定 ────────────────────────────────────────────────────────────────
LOG_LEVEL=info         # debug | info | warn | error
DRY_RUN=false          # true = 変更をSFに適用せず確認のみ
